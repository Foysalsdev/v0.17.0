# ─────────────────────────────────────────────────────────────
# গাড়িখাতা — environment নমুনা (copy → .env.local, মান বসান)
# লোকাল ডেভেলপমেন্টে দরকার; production (Cloudflare) বিল্ড ভ্যারিয়েবল
# ড্যাশবোর্ড থেকে আসে — নিচের নামগুলোই সেখানে বসবে।
# ─────────────────────────────────────────────────────────────

# Supabase (Dashboard → Settings → API)
# publishable/anon key — পাবলিক, গোপন নয়; RLS নিজেই ডেটা আটকায়
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY

# ব্যাকএন্ড: local (SQLite, অফলাইন ডেভ) | supabase (production)
GK_BACKEND=supabase

# cloud মোডের UI ফিচার (Google বাটন ইত্যাদি) চালু
NEXT_PUBLIC_GK_CLOUD=1

# local মোডের SQLite ফাইল (GK_BACKEND=local হলে লাগবে)
DATABASE_URL=file:./db/custom.db

# ফোন-লগইনের synthetic ইমেইল ডোমেইন (default-ই ঠিক)
# GK_EMAIL_DOMAIN=supabase.io
# GK_LEGACY_EMAIL_DOMAIN=garirkhata.app

# ── Admin panel (v1.0) — /admin পেজের signing secret + বিকল্প লগইন-কী ──
# শুধু সার্ভারে থাকে; ব্রাউজারে যায় না। ২৪+ অক্ষরের র‍্যান্ডম স্ট্রিং দিন:
#   openssl rand -hex 24
# দুই কাজ: (১) অ্যাডমিন সেশন-কুকি HMAC-sign, (২) "অ্যাডমিন কী" ট্যাব
# দিয়ে লগইন। আসল পথ অবশ্য নিজের অ্যাকাউন্ট (ফোন+পাসওয়ার্ড) — সেজন্য
# Supabase-এ sql/v1.0-final-setup.sql চালিয়ে is_platform_admin ফ্ল্যাগ
# দিন; তাহলে service key ছাড়াই আসল ক্লাউড ডেটা দেখাবে।
GK_ADMIN_KEY=gk_live_openssl_rand_hex_24_bos_an

# ── (ঐচ্ছিক) Admin panel-এর ক্লাউড ডেটা — service-role secret ──
# দরকার নেই যদি অ্যাকাউন্ট-লগইন (is_platform_admin) ব্যবহার করেন।
# দিলে: Supabase → Settings → API → service_role key। RLS bypass
# করে বলে কখনো ক্লায়েন্টে নয়। Cloudflare-এ: wrangler secret put SUPABASE_SERVICE_ROLE
# SUPABASE_SERVICE_ROLE=
